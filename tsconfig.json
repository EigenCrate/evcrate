{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/evcrate/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"]
}
