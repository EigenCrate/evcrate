#!/usr/bin/env node
'use strict';
const cancellation = new AbortController();
const onSignal = () => cancellation.abort();
process.on('SIGINT', onSignal);
process.on('SIGTERM', onSignal);
process.on('message', (msg) => {
  if (msg === 'SIGINT' || msg === 'SIGTERM') onSignal();
});
process.on('disconnect', onSignal);

const {
  runController, runQualificationDiagnostic, isDiagnosticRequest
} = require('./lib/advisor/controller.cjs');
const { parseJsonDocument } = require('./lib/advisor/json-document.cjs');
const { createRoutingError } = require('./lib/advisor/errors.cjs');
const { buildFailureEnvelope } = require('./lib/advisor/controller-envelope.cjs');
const { runManagedCheckpoint } = require('./lib/advisor/managed-checkpoint.cjs');
const { executeStateRequest, preflightHumanDecision } = require('./lib/advisor/task-state.cjs');
const { observeTerminalDecision } = require('./lib/advisor/state-human.cjs');
const { serializeRoutingError } = require('./lib/advisor/errors.cjs');
const { parseHistoryRequest } = require('./lib/advisor/history-contract.cjs');
const { listHistory, getHistoryEntry, exportHistory, pruneHistory, getHistoryMetrics } = require('./lib/advisor/history-store.cjs');
const { loadGlobalPolicy } = require('./lib/advisor/profile.cjs');

const MAX_INPUT_BYTES = 32 * 1024;
const PRE_POLICY_INPUT_TIMEOUT_MS = 2_000;
function readStdin(signal, timeoutMs = PRE_POLICY_INPUT_TIMEOUT_MS, maxBytes = MAX_INPUT_BYTES) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    let settled = false;
    let timer;
    let onData;
    let onEnd;
    let onError;
    const removeInputListeners = () => {
      process.stdin.removeListener('data', onData);
      process.stdin.removeListener('end', onEnd);
      process.stdin.removeListener('error', onError);
    };
    const finish = (value, error = null) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      removeInputListeners();
      signal?.removeEventListener('abort', onAbort);
      if (error) reject(error);
      else resolve(value);
    };
    const closeInput = () => {
      try { process.stdin.pause(); } catch {}
      try { process.stdin.destroy(); } catch {}
    };
    const onAbort = () => {
      closeInput();
      finish(Buffer.alloc(0));
    };
    onData = (chunk) => {
      if (settled) return;
      const value = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
      size += value.length;
      if (size > maxBytes) {
        closeInput();
        finish(Buffer.alloc(maxBytes + 1));
        return;
      }
      chunks.push(value);
    };
    onEnd = () => finish(Buffer.concat(chunks));
    onError = () => finish(Buffer.alloc(0));
    process.stdin.on('data', onData);
    process.stdin.on('end', onEnd);
    process.stdin.on('error', onError);
    signal?.addEventListener('abort', onAbort, { once: true });
    timer = setTimeout(() => {
      closeInput();
      finish(null, createRoutingError('TIMEOUT'));
    }, timeoutMs);
    if (signal?.aborted) onAbort();
    process.stdin.resume();
  });
}

async function dispatch(input, dependencies) {
  let raw;
  try { raw = await input; } catch { return runController(input, dependencies); }
  let parsed;
  try {
    const text = Buffer.isBuffer(raw) || raw instanceof Uint8Array
      ? Buffer.from(raw).toString('utf8') : raw;
    parsed = parseJsonDocument(text, 'REQUEST_INVALID', 'REQUEST_INVALID');
  } catch {
    try {
      const text = Buffer.isBuffer(raw) || raw instanceof Uint8Array
        ? Buffer.from(raw).toString('utf8') : raw;
      if (isDiagnosticRequest(JSON.parse(text))) return runQualificationDiagnostic(raw, dependencies);
    } catch {}
    return runController(raw, dependencies);
  }
  if (isDiagnosticRequest(parsed)) return runQualificationDiagnostic(raw, dependencies);
  return runManagedCheckpoint(raw, dependencies);
}

async function dispatchState(input, dependencies, operation) {
  try {
    const raw = await input;
    if (dependencies.signal?.aborted) throw createRoutingError('CANCELLED');
    if (raw.byteLength > 64 * 1024) throw createRoutingError('STATE_INVALID');
    const request = parseJsonDocument(
      new TextDecoder('utf-8', { fatal: true }).decode(raw), 'STATE_INVALID', 'STATE_INVALID'
    );
    if (request.operation !== operation) throw createRoutingError('STATE_INVALID');
    let observation;
    if (operation === 'human-decision') {
      const replay = preflightHumanDecision(request, dependencies);
      if (replay !== null) return replay;
      // Observe outside the short CAS transaction, then recheck its revision.
      observation = await observeTerminalDecision(request, dependencies.signal);
    }
    return executeStateRequest(request, {
      ...dependencies,
      observeHumanDecision: observation ? () => observation : undefined
    });
  } catch (error) {
    return { protocol: 'evcrate-advisor-state', version: 1, status: 'FAILED',
      error: serializeRoutingError(error) };
  }
}
async function dispatchHistory(input, dependencies, operation) {
  try {
    const raw = await input;
    if (dependencies.signal?.aborted) throw createRoutingError('CANCELLED');
    if (raw.byteLength > 64 * 1024) throw createRoutingError('REQUEST_INVALID');
    if (!['list', 'show', 'export', 'prune', 'metrics'].includes(operation)) {
      throw createRoutingError('REQUEST_INVALID');
    }
    const request = parseHistoryRequest(raw, operation);
    const environment = dependencies.environment || process.env;
    let policy = null;
    try {
      const loaded = await loadGlobalPolicy(environment?.HOME);
      policy = loaded?.policy ?? loaded;
    } catch {}

    if (operation === 'list') {
      return listHistory(dependencies, request);
    } else if (operation === 'show') {
      return getHistoryEntry(dependencies, {
        projectId: request.project_id,
        taskRunId: request.task_run_id,
        consultationId: request.consultation_id
      });
    } else if (operation === 'export') {
      return exportHistory(dependencies, request);
    } else if (operation === 'prune') {
      return pruneHistory(dependencies, policy || {}, request);
    } else if (operation === 'metrics') {
      return getHistoryMetrics(dependencies, request);
    }
    throw createRoutingError('REQUEST_INVALID');
  } catch (error) {
    return {
      protocol: 'evcrate-advisor-history',
      version: 1,
      operation: operation || 'unknown',
      status: 'FAILED',
      error: serializeRoutingError(error)
    };
  }
}
async function main() {
  process.stdout.on('error', (err) => {
    if (err?.code === 'EPIPE') {
      process.exit(process.exitCode ?? 0);
    } else {
      process.exit(1);
    }
  });
  process.stderr?.on('error', (err) => {
    if (err?.code === 'EPIPE') {
      // ignore warning-side EPIPE
    }
  });

  let envelope;
  try {
    const args = process.argv.slice(2);
    const dependencies = { signal: cancellation.signal, cwd: process.cwd(), environment: process.env };
    if (args.length === 2 && args[0] === 'state') {
      envelope = await dispatchState(
        readStdin(cancellation.signal, PRE_POLICY_INPUT_TIMEOUT_MS, 64 * 1024), dependencies, args[1]
      );
    } else if (args.length === 2 && args[0] === 'history') {
      envelope = await dispatchHistory(
        readStdin(cancellation.signal, PRE_POLICY_INPUT_TIMEOUT_MS, 64 * 1024), dependencies, args[1]
      );
    } else if (args.length !== 0) {
      throw createRoutingError('REQUEST_INVALID');
    } else {
      envelope = await dispatch(readStdin(cancellation.signal), dependencies);
    }
  } catch {
    envelope = buildFailureEnvelope({ error: createRoutingError('PROCESS_FAILED'), receipt: { elapsed_ms: 0 } });
  }
  try {
    process.stdout.write(JSON.stringify(envelope) + '\n');
  } catch (err) {
    if (err?.code !== 'EPIPE') {
      process.exitCode = 1;
      process.removeListener('SIGINT', onSignal);
      process.removeListener('SIGTERM', onSignal);
      return;
    }
  }
  const exitCode = ['ADVICE_READY', 'QUALIFIED', 'STATE_READY', 'HISTORY_READY'].includes(envelope.status) ? 0 : 1;
  process.exit(exitCode);
}

void main();
