{
  "evcrate-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node .antigravity/hooks/pre-invocation.cjs"
      }
    ]
  },
  "evcrate-policy": {
    "PreToolUse": [
      {
        "matcher": "run_command|grep_search|find_by_name|list_dir|view_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .antigravity/hooks/scout-block.cjs"
          },
          {
            "type": "command",
            "command": "node .antigravity/hooks/privacy-block.cjs"
          }
        ]
      }
    ]
  }
}