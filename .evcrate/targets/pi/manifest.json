{
  "schema_version": 2,
  "name": "pi",
  "adapter": "migrate_claude_to_pi.py",
  "adapter_sources": [
    "distribution/contracts.py",
    "pi_adapter/__init__.py",
    "pi_adapter/agents.py",
    "pi_adapter/frontmatter.py",
    "pi_adapter/resources.py"
  ],
  "output_root": ".pi",
  "additional_roots": [],
  "owned_paths": [
    "files/agent/extensions/evcrate/ATTRIBUTION.md",
    "files/agent/extensions/evcrate/child-context.js",
    "files/agent/extensions/evcrate/command-files.js",
    "files/agent/extensions/evcrate/command-tool.js",
    "files/agent/extensions/evcrate/commands.js",
    "files/agent/extensions/evcrate/delegation-tool.js",
    "files/agent/extensions/evcrate/hook-adapter.cjs",
    "files/agent/extensions/evcrate/hooks.js",
    "files/agent/extensions/evcrate/index.js",
    "files/agent/extensions/evcrate/model-roles.js",
    "files/agent/extensions/evcrate/operation-policy.js",
    "files/agent/extensions/evcrate/paths.js"
  ],
  "overlay_root": ".evcrate/targets/pi/files",
  "shared_json": {
    "schema": "pi-settings-v1",
    "destination": "agent/settings.json",
    "fragment": "agent/evcrate/managed-settings.json",
    "managed_keys": ["packages"]
  },
  "project_docs": [],
  "patches": [],
  "home_policy": {
    "bindings": {".pi": ".pi"},
    "preserve_paths": {},
    "promotion_order": 25
  }
}
