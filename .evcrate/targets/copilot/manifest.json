{
  "schema_version": 2,
  "name": "copilot",
  "adapter": "dist/adapters/copilot/index.js",
  "adapter_sources": [
    "dist/adapters/copilot/adapter.js",
    "dist/adapters/copilot/agents.js",
    "dist/adapters/copilot/bridge.js",
    "dist/adapters/copilot/commands.js",
    "dist/adapters/copilot/common.js",
    "dist/adapters/copilot/hooks.js",
    "dist/adapters/copilot/instructions.js",
    "dist/adapters/copilot/inventory.js",
    "dist/adapters/copilot/prompts.js",
    "dist/adapters/copilot/resources.js",
    "dist/adapters/copilot/skills.js",
    "dist/adapters/copilot/styles.js",
    "dist/adapters/copilot/support.js",
    "dist/adapters/copilot/text.js"
  ],
  "output_root": ".copilot",
  "additional_roots": [],
  "project_docs": [],
  "patches": [],
  "shared_json": {
    "schema": "managed-json-v1",
    "destination": "settings.json",
    "fragment": "evcrate/managed-settings.json",
    "managed_keys": ["includeCoAuthoredBy", "effortLevel", "statusLine"]
  },
  "home_policy": {
    "bindings": {".copilot": ".copilot"},
    "preserve_paths": {},
    "promotion_order": 40,
    "reject_unmanaged_collisions": true,
    "publication_rules": ["copilot-home-path-rewrite"]
  }
}
