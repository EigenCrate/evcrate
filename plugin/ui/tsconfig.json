{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../viewer/src/**/*.ts",
    "../../viewer/src/**/*.tsx",
    "../../viewer/src/**/*.d.ts"
  ]
}
