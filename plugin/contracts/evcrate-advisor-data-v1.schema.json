      "type": "object",
      "required": [
        "backend",
        "model",
        "effort"
      ],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "antigravity",
            "pi",
            "omp"
          ]
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            null
          ]
        }
      }
    },
