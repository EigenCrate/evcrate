          }
        },
        "outcome_states": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "missing",
              "valid",
              "invalid"
            ]
          }
        },
        "outcome_results": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "resolved",
              "unresolved",
              "regressed",
              "unknown"
            ]
          }
        },
        "backends": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "models": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "efforts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "prompt_identities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "build_identities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "started_at_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "started_at_to": {
          "type": [
            "integer",
            "null"
          ]
        }
