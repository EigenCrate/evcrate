{
  "name": "evcrate",
  "version": "1.0.0",
  "description": "A comprehensive boilerplate template for Claude Code, GitHub Copilot CLI, OpenCode, OMP, and native Pi coding agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "evcrate": "dist/cli/evcrate.js",
    "evcrate-advisor": ".evcrate/source/.evcrate/bin/evcrate-advisor"
  },
  "scripts": {
    "prebuild": "node scripts/generate-controller-inventory.mjs",
    "build": "tsc -p tsconfig.json",
    "test:protocol": "npm run build && node --test tests/protocol/*.test.mjs",
    "test:cli": "npm run build && node --test tests/cli/*.test.mjs tests/context/*.test.mjs",
    "test:phase4": "npm run build && node --test tests/filesystem/distribution-primitives.test.mjs tests/manifests/distribution-manifests.test.mjs tests/advisor-settings/distribution-primitives.test.mjs",
    "distribute": "node dist/cli/evcrate.js distribute all",
    "test:phase5": "npm run build && node --test tests/adapters/*.test.mjs",
    "test:phase6": "npm run build && node --test tests/registry/resource-registry.test.mjs tests/imports/import-preview.test.mjs tests/imports/import-apply.test.mjs tests/cli/phase6-resource-commands.test.mjs tests/cli/request-file.test.mjs",
    "test:phase7": "npm run build && node --test tests/scopes/*.test.mjs tests/advisor-settings/*.test.mjs",
    "test:phase8": "npm run build && node --test tests/protocol/contracts.test.mjs tests/cli/arguments.test.mjs tests/cli/phase8-publication.test.mjs tests/distribution/*.test.mjs",
    "test:phase9": "npm run build && node --test tests/integration/*.test.mjs",
    "test:phase10": "npm run build && node --test tests/phase10/*.test.mjs",
    "distribute:build": "node dist/cli/evcrate.js distribute build",
    "distribute:check": "node dist/cli/evcrate.js distribute check",
    "distribute:publish": "node dist/cli/evcrate.js publish --apply",
    "distribute:all": "node dist/cli/evcrate.js distribute all",
    "distribute:pi": "node dist/cli/evcrate.js distribute all --target pi",
    "distribute:omp": "node dist/cli/evcrate.js distribute all --target omp",
    "distribute:copilot": "node dist/cli/evcrate.js distribute all --target copilot",
    "test": "npm run test:protocol && npm run test:cli && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:advisor-controller",
    "test:advisor-controller": "node --test tests/advisor-controller/*.test.cjs",
    "lint": "echo \"Linting passed\"",
    "semantic-release": "semantic-release",
    "prepack": "npm run build",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEBULEA-M/evcrate.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "development-template",
    "boilerplate",
    "automation",
    "cli-tools"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NEBULEA-M/evcrate/issues"
  },
  "homepage": "https://github.com/NEBULEA-M/evcrate#readme",
  "files": [
    "dist/**",
    ".evcrate/**",
    "plans/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/node": "^22.20.1",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "pi-subagents": "0.44.0",
    "semantic-release": "^22.0.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pi-code-graph": "^0.16.0"
  }
}
