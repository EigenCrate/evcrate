{
  "name": "devkit",
  "version": "1.0.0",
  "description": "A comprehensive boilerplate template for building professional software projects with CLI Coding Agents (Claude Code and Open Code).",
  "main": "index.js",
  "scripts": {
    "distribute": "python3 distribute.py",
    "distribute:build": "python3 distribute.py --build",
    "distribute:check": "python3 distribute.py --check",
    "distribute:publish": "python3 distribute.py --publish",
    "distribute:all": "python3 distribute.py --all",
    "migrate:gemini": "python3 migrate_claude_to_gemini.py",
    "migrate:codex": "python3 migrate_claude_to_codex.py",
    "test": "python3 -m unittest tests.test_distribution_build tests.test_distribution_cli tests.test_distribution_publish tests.test_advisor_skill_distribution",
    "lint": "echo \"Linting passed\"",
    "semantic-release": "semantic-release",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEBULEA-M/devkit.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "development-template",
    "boilerplate",
    "automation",
    "cli-tools"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NEBULEA-M/devkit/issues"
  },
  "homepage": "https://github.com/NEBULEA-M/devkit#readme",
  "files": [
    ".claude/",
    ".opencode/",
    "plans/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    ".claude/metadata.json"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "semantic-release": "^22.0.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
