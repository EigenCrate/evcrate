{
  "name": "evcrate",
  "version": "1.0.0",
  "description": "A comprehensive boilerplate template for Claude Code, OpenCode, and native Pi coding agents.",
  "main": "index.js",
  "scripts": {
    "distribute": "bash -o pipefail -c 'python3 distribute.py --all 2>&1 | tee logs.txt'",
    "distribute:build": "python3 distribute.py --build",
    "distribute:check": "python3 distribute.py --check",
    "distribute:publish": "python3 distribute.py --publish",
    "distribute:all": "python3 distribute.py --all",
    "distribute:pi": "python3 distribute.py --all --target pi",
    "migrate:gemini": "python3 migrate_claude_to_gemini.py",
    "migrate:codex": "python3 migrate_claude_to_codex.py",
    "test": "npm run test:python && npm run test:pi && npm run test:advisor-routing",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:pi": "node --test .evcrate/targets/pi/tests/*.test.mjs",
  "test:advisor-routing": "node --test .evcrate/source/.claude/scripts/__tests__/advisor-routing-integration.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-checkpoint-contract.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-profile.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-runner.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-adapter-contract.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-codex-adapter.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-claude-adapter.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-gemini-adapter.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-antigravity-adapter.test.cjs .evcrate/source/.claude/scripts/__tests__/advisor-routing-pi-adapter.test.cjs",
    "lint": "echo \"Linting passed\"",
    "semantic-release": "semantic-release",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEBULEA-M/evcrate.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "development-template",
    "boilerplate",
    "automation",
    "cli-tools"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NEBULEA-M/evcrate/issues"
  },
  "homepage": "https://github.com/NEBULEA-M/evcrate#readme",
  "files": [
    ".evcrate/source/.claude/**",
    ".evcrate/source/.opencode/**",
    ".evcrate/source/.pi/**",
    ".evcrate/targets/**",
    "distribution/**",
    "distribute.py",
    "distribute_hooks.py",
    "distribute_sync.py",
    "distribute_utils.py",
    "migrate_claude_to_codex.py",
    "migrate_claude_to_gemini.py",
    "migrate_claude_to_pi.py",
    "pi_adapter/**",
    "!**/__tests__/advisor-routing-*.test.cjs",
    "!**/__tests__/fixtures/**",
    "!**/__tests__/helpers/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    ".evcrate/source/AGENTS.md",
    ".evcrate/source/CLAUDE.md",
    ".evcrate/source/GEMINI.md",
    "plans/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".evcrate/source/.claude/metadata.json"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "pi-subagents": "0.44.0",
    "semantic-release": "^22.0.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pi-code-graph": "^0.16.0"
  }
}
