{
  "name": "evcrate",
  "version": "1.0.0",
  "description": "A comprehensive boilerplate template for Claude Code, GitHub Copilot CLI, OpenCode, OMP, and native Pi coding agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "evcrate": "dist/cli/evcrate.js",
    "evcrate-advisor": ".evcrate/source/.evcrate/bin/evcrate-advisor"
  },
  "scripts": {
    "prebuild": "python3 scripts/generate-controller-inventory.py",
    "build": "tsc -p tsconfig.json",
    "test:protocol": "npm run build && node --test tests/protocol/*.test.mjs",
    "test:cli": "npm run build && node --test tests/cli/*.test.mjs tests/context/*.test.mjs",
    "test:phase4": "npm run build && node --test tests/filesystem/distribution-primitives.test.mjs tests/manifests/distribution-manifests.test.mjs tests/advisor-settings/distribution-primitives.test.mjs",
    "distribute": "bash -o pipefail -c 'python3 distribute.py --all 2>&1 | tee logs.txt'",
    "test:phase5": "npm run build && node --test tests/adapters/*.test.mjs",
    "distribute:build": "python3 distribute.py --build",
    "distribute:check": "python3 distribute.py --check",
    "distribute:publish": "python3 distribute.py --publish",
    "distribute:all": "python3 distribute.py --all",
    "distribute:pi": "python3 distribute.py --all --target pi",
    "distribute:omp": "python3 distribute.py --all --target omp",
    "distribute:copilot": "python3 distribute.py --all --target copilot",
    "migrate:gemini": "python3 migrate_claude_to_gemini.py",
    "migrate:codex": "python3 migrate_claude_to_codex.py",
    "migrate:omp": "python3 migrate_claude_to_omp.py",
    "migrate:copilot": "python3 migrate_claude_to_copilot.py",
    "test": "npm run test:python && npm run test:pi && npm run test:advisor-controller",
    "test:python": "python3 -m unittest tests.test_advisor_skill_distribution tests.test_distribution_build tests.test_distribution_publish tests.test_distribution_publish_symlinks tests.test_distribution_cli tests.test_distribution_pi tests.test_distribution_pi_settings tests.test_distribution_managed_json tests.test_pi_resource_migration tests.test_migrate_claude_to_codex tests.test_migrate_claude_to_gemini tests.test_migrate_claude_to_omp tests.test_migrate_claude_to_pi tests.test_migrate_claude_to_copilot",
    "test:pi": "node --test --test-concurrency=1 .evcrate/targets/pi/tests/*.test.mjs",
    "test:advisor-controller": "node --test tests/advisor-controller/*.test.cjs",
    "lint": "echo \"Linting passed\"",
    "semantic-release": "semantic-release",
    "prepack": "npm run build",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEBULEA-M/evcrate.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "development-template",
    "boilerplate",
    "automation",
    "cli-tools"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NEBULEA-M/evcrate/issues"
  },
  "homepage": "https://github.com/NEBULEA-M/evcrate#readme",
  "files": [
    "dist/**",
    ".evcrate/source/.claude/**",
    ".evcrate/source/.evcrate/bin/**",
    ".evcrate/targets/**",
    ".evcrate/source/.pi/**",
    ".evcrate/source/.omp/**",
    ".evcrate/source/.copilot/**",
    "distribution/**",
    "distribute.py",
    "distribute_hooks.py",
    "distribute_sync.py",
    "distribute_utils.py",
    "migrate_claude_to_codex.py",
    "migrate_claude_to_gemini.py",
    "migrate_claude_to_omp.py",
    "migrate_claude_to_copilot.py",
    "migrate_claude_to_pi.py",
    "omp_adapter/**",
    "copilot_adapter/**",
    "pi_adapter/**",
    "!**/__tests__/fixtures/**",
    "!**/__tests__/helpers/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    ".evcrate/source/AGENTS.md",
    ".evcrate/source/CLAUDE.md",
    ".evcrate/source/GEMINI.md",
    "plans/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".evcrate/source/.claude/metadata.json"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/node": "^22.20.1",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "pi-subagents": "0.44.0",
    "semantic-release": "^22.0.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pi-code-graph": "^0.16.0"
  }
}
