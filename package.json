{
  "name": "evcrate",
  "version": "1.0.0",
  "description": "A comprehensive boilerplate template for building professional software projects with CLI Coding Agents (Claude Code and Open Code).",
  "main": "index.js",
  "scripts": {
    "distribute": "python3 distribute.py",
    "distribute:build": "python3 distribute.py --build",
    "distribute:check": "python3 distribute.py --check",
    "distribute:publish": "python3 distribute.py --publish",
    "distribute:all": "python3 distribute.py --all",
    "migrate:gemini": "python3 migrate_claude_to_gemini.py",
    "migrate:codex": "python3 migrate_claude_to_codex.py",
    "test": "npm run test:python && npm run test:pi",
    "test:python": "python3 -m unittest tests.test_distribution_build tests.test_distribution_cli tests.test_distribution_publish tests.test_distribution_publish_symlinks tests.test_advisor_skill_distribution tests.test_migrate_claude_to_gemini",
    "test:pi": "node --test .evcrate/targets/pi/tests/*.test.mjs",
    "lint": "echo \"Linting passed\"",
    "semantic-release": "semantic-release",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEBULEA-M/evcrate.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "development-template",
    "boilerplate",
    "automation",
    "cli-tools"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NEBULEA-M/evcrate/issues"
  },
  "homepage": "https://github.com/NEBULEA-M/evcrate#readme",
  "files": [
    ".evcrate/source/.claude/**",
    ".evcrate/source/.opencode/**",
    ".evcrate/source/.pi/**",
    ".evcrate/targets/pi/**",
    "distribution/**",
    "distribute.py",
    "migrate_claude_to_pi.py",
    "pi_adapter/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    ".evcrate/source/AGENTS.md",
    ".evcrate/source/CLAUDE.md",
    ".evcrate/source/GEMINI.md",
    "plans/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    ".claude/metadata.json"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "pi-subagents": "0.44.0",
    "semantic-release": "^22.0.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pi-code-graph": "^0.16.0"
  }
}
